{
  // The build config, which runs in Node rather than the browser. The app's
  // own sources are checked by tsconfig.json.
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2023"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "pretty": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["vite.config.mts", "quantumThemeInit.ts"]
}
